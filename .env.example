# RailSync 360 - Environment Configuration Template

# Profile: LOCAL_DEMO or CLOUD
APP_PROFILE=LOCAL_DEMO

# Security & Tokens
SECRET_KEY=railsync-360-dev-secret-key-change-in-production-2026-adbms
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Authoritative MySQL Connection (Local Docker or AWS RDS)
# Local Docker: mysql+pymysql://railsync_user:railsync_pass@localhost:3307/railsync_db
# AWS RDS: mysql+pymysql://<user>:<password>@<rds-endpoint>:3306/railsync_db
DATABASE_URL=mysql+pymysql://railsync_user:railsync_pass@localhost:3307/railsync_db
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:

# Firebase Realtime Database
# Web URL for client subscription and admin SDK
FIREBASE_DATABASE_URL=https://railsync360-demo-default-rtdb.firebaseio.com/
# Path to service account json credentials (optional in LOCAL_DEMO fallback)
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_ENABLED=false

# Azure Cosmos DB (NoSQL API)
# Optional in LOCAL_DEMO profile; set credentials when connecting to real Azure Cosmos instance
COSMOS_ENDPOINT=https://railsync-cosmos-demo.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=RailSyncRecords
COSMOS_CONTAINER=RegionalBookingEvents
COSMOS_ENABLED=false

# Outbox Worker Configuration
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_BATCH_SIZE=10
